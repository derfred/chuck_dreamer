#!/usr/bin/python3
# Launcher for the Fessel supervisor process, installed to /usr/bin by the
# dpkg. The Fessel modules ship to a private /opt/fessel/lib (NOT
# dist-packages) to avoid colliding with generic top-level names like
# `supervisor`; we put that dir first on sys.path for THIS process only.
import sys

sys.path.insert(0, "/opt/fessel/lib")

from supervisor.main import main

main()
