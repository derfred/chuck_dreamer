#!/usr/bin/python3
# Launcher for the Fessel video process, installed to /usr/bin by the dpkg.
# Runs the SYSTEM python3 directly so `gi`/GStreamer bind to the apt-installed
# introspection libraries. Fessel modules live in a private /opt/fessel/lib
# (prepended to sys.path here) to avoid colliding with the generic top-level
# name `video`.
import sys

sys.path.insert(0, "/opt/fessel/lib")

from video.main import main

main()
