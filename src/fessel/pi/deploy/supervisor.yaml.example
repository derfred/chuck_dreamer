# Example supervisor config. Copied to /etc/fessel/supervisor.yaml.
mqtt:
  host: 127.0.0.1
  port: 1883

http:
  host: 0.0.0.0
  port: 8443
  # In production, terminate HTTPS here (reachable from the cluster over
  # Tailscale). For local dev, leave these unset to serve plain HTTP.
  # tls_certfile: /etc/fessel/tls/supervisor.crt
  # tls_keyfile: /etc/fessel/tls/supervisor.key

# Slice 3 control plane: the actuators supervisor drives directly.
# Omit a plug (no address) or the jetson block to disable the matching
# endpoints rather than have them pretend an actuator exists.
control:
  plugs:
    # WiZ smart plugs on the local LAN (pywizlight over UDP, port 38899).
    # IMPORTANT: the device switching the ARM supply must be load-rated for
    # the arm's current draw — a hardware prerequisite, verified at install.
    arm:
      address: 192.168.1.50
    jetson:
      address: 192.168.1.51
  wiz:
    # Send-and-verify retry policy. A lost UDP power-off is a missed safety
    # intervention, so each attempt re-issues the command and reads it back.
    retries: 3
    retry_delay_s: 0.2
  jetson:
    # Jetson control API over the local LAN (not on the tailnet). Short
    # timeout: long timeouts hide failures on a local LAN.
    base_url: http://192.168.1.40:8080
    timeout_s: 3.0
    # Optional pre-shared token sent as `Authorization: Bearer <token>`.
    # Leave unset if the LAN is trusted (agree with the Jetson team).
    # auth_token: null
  refresh:
    # Slow background refresh that keeps /state's cached view fresh without
    # re-querying on every read.
    jetson_s: 5.0
    plug_s: 10.0
