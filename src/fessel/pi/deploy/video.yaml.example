# Example video config. Copied to /etc/fessel/video.yaml.
mqtt:
  host: 127.0.0.1
  port: 1883

srt:
  # mediamtx's Tailscale magicDNS name (from tailscale-ingress.yaml) + 8890.
  host: mediamtx-srt
  port: 8890

camera:
  device: /dev/video0
  # Set true on dev machines with no camera: uses a videotestsrc pattern.
  use_test_source: false

live:
  # How long `starting` waits for srtsink to connect before giving up to
  # `off`. A config parameter, not hardcoded (V1.4).
  connect_timeout_s: 15.0
