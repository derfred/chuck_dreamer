[Unit]
Description=Fessel supervisor (safety/control plane + MQTT relay)
After=network.target fessel-mosquitto.service
Wants=fessel-mosquitto.service

[Service]
Environment=SUPERVISOR_CONFIG=/etc/fessel/supervisor.yaml
ExecStart=/opt/fessel/supervisor/.venv/bin/supervisor
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
