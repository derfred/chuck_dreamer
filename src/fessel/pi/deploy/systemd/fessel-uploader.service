[Unit]
Description=Fessel uploader (ships flagged recordings to MinIO)
After=network.target fessel-mosquitto.service
Wants=fessel-mosquitto.service

[Service]
Environment=FESSEL_CONFIG=/etc/fessel/fessel.yaml
# Launcher wrapper (ships in /usr/bin from the dpkg). Runs the system python3
# directly against /opt/fessel/lib (no venv). The MinIO SDK is imported lazily,
# so the process starts even where python3-minio is absent (the 'fake' driver
# needs no SDK); production must provide the SDK for the 'minio' driver.
ExecStart=/usr/bin/fessel-uploader
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
