[Unit]
Description=Fessel video (GStreamer pipeline + live state machine)
After=network.target fessel-mosquitto.service
Wants=fessel-mosquitto.service

[Service]
Environment=FESSEL_CONFIG=/etc/fessel/fessel.yaml
# Launcher wrapper (ships in /usr/bin from the dpkg). It runs the SYSTEM
# /usr/bin/python3 directly, so PyGObject (gi) binds to the apt-installed
# GObject-introspection / GStreamer libraries (python3-gi + gstreamer1.0-*
# from Depends). No venv involved.
ExecStart=/usr/bin/fessel-video
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
