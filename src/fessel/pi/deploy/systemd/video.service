[Unit]
Description=Fessel video (GStreamer pipeline + live state machine)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Environment=VIDEO_CONFIG=/etc/fessel/video.yaml
# Invoke the venv binary DIRECTLY. The venv must be created with
# --system-site-packages so PyGObject (gi) binds to the apt-installed
# GObject-introspection / GStreamer libraries. A wrapper that re-resolves
# the interpreter (e.g. `uv run`) ignores --system-site-packages and fails
# to find gi.
ExecStart=/opt/fessel/video/.venv/bin/video
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
