[Unit]
Description=Fessel supervisor (safety/control plane + MQTT relay)
After=network.target fessel-mosquitto.service
Wants=fessel-mosquitto.service

[Service]
Environment=FESSEL_CONFIG=/etc/fessel/fessel.yaml
# Launcher wrapper (ships in /usr/bin from the dpkg); it prepends
# /opt/fessel/lib to sys.path and runs supervisor.main:main on system python3.
ExecStart=/usr/bin/fessel-supervisor
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
