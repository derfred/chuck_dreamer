# Example Fessel Pi config. Copied to /etc/fessel/fessel.yaml.
#
# A SINGLE config file for the whole Pi (Requirements §6). Shared sections
# (`mqtt`, `storage`) sit at the top level; each process reads its own subtree
# (`video:` / `supervisor:` / `uploader:`) plus those shared sections. This
# removes the duplicate mqtt/storage that the old per-process files carried.

# --- shared (read by every process) -----------------------------------------

mqtt:
  host: 127.0.0.1
  port: 1883

storage:
  # USB SSD mount. video writes the ring + recordings here; supervisor and the
  # uploader read from the same mount. ONE source of truth for the path.
  ssd_path: /mnt/ssd

# --- video ------------------------------------------------------------------

video:
  whip:
    # The webui relay's WHIP ingest endpoint: the webui pod's tsnet-sidecar
    # tailnet IP/name + the tailnet-only ingest port, full URL ending in
    # /whip/ingest (architecture §2.2/§4.2). Restart-only (no SIGHUP apply).
    endpoint: "http://webui.tailnet.ts.net:8001/whip/ingest"

  camera:
    device: /dev/video0
    # Set true on dev machines with no camera: uses a videotestsrc pattern.
    use_test_source: false

  live:
    # The WARM live encoder's fixed deploy-time profile (§2.2). Deliberately
    # lower quality than the recording encoders — the live view is situational
    # awareness, not the archived artifact. No per-session mode selection.
    # Restart-only (the warm encoder is baked into the capture pipeline).
    resolution: 640x480
    fps: 10
    bitrate_bps: 1000000
    # How long `starting` waits for the WHIP session to establish before
    # giving up to `off`. A config parameter, not hardcoded (V1.4); the
    # Pi-side complement of the relay's live_activation_timeout.
    connect_timeout_s: 15.0

  ring:
    # Always-on ring buffer (V4.1). Review-quality, short window. GOP is derived
    # so every HLS segment starts on a keyframe (= fps * segment_seconds).
    resolution: 1280x720
    fps: 30
    bitrate_bps: 2000000
    segment_seconds: 2
    # playlist_length * segment_seconds ~= the scrubbable window (here ~5 min).
    playlist_length: 150
    # Slightly larger than playlist_length so rotated segments are deleted, not
    # retained indefinitely (hlssink2 deletes past max_files).
    max_files: 160

  recording:
    # Explicit (operator) recordings (V4.2). Retention-quality, finite.
    bitrate_bps: 8000000
    segment_seconds: 2
    # How long the recording state machine waits for the first segment before
    # giving up to idle (V4.3).
    start_timeout_s: 15.0

  # Slice 5 vision analysis (V5.5). Runs on the always-on appsink branch
  # (640x360). All values are starting points; tune against the real scene by
  # watching the dashboard's live activity score.
  vision:
    background_subtractor:
      # MOG2 (default) or KNN; history + variance threshold control sensitivity.
      algorithm: MOG2
      history: 500
      var_threshold: 16
    # EMA smoothing for the published activity score (raw per-frame is noisy).
    ema_alpha: 0.1
    # Morphological-open kernel size (rejects single-pixel noise before counting).
    morphology: { kernel: 3 }
    # Vision summary publish cadence (Hz) — dashboard-readable, MQTT-trivial.
    publish_summary_hz: 1
    # The arm's expected workspace as an image-space rectangle in 640x360 coords.
    # CRITICAL: no good default — it is camera-position-specific and MUST be set
    # at install. Use scripts/safe_box_preview.py to capture a frame with this
    # rectangle overlaid and confirm it visually (X5.2).
    safe_box: { x: 100, y: 60, w: 440, h: 240 }
    # Fraction of foreground OUTSIDE the box that counts as a violation, and how
    # many consecutive frames it must persist (debounce vs. a fly across lens).
    safe_box_threshold: 0.05
    safe_box_debounce_frames: 12
    # During a rest period (between episodes / paused), activity above this (much
    # lower — "essentially still") for the debounce window is a rest violation.
    rest_threshold: 0.03
    rest_debounce_frames: 30

  # Slice 5 audio analysis (V5.6). Runs on the always-on level branch.
  audio:
    # Set false to run without a microphone entirely (video is unaffected;
    # audio anomaly analysis is disabled). The pipeline ALSO auto-degrades to
    # this at startup when the device below cannot be opened.
    enabled: true
    # ALSA capture device for the analysis branch (default = system default).
    device: default
    # Rolling window (s) over which the baseline median is taken.
    rolling_window_seconds: 5
    # A spike: RMS over threshold for min_duration_ms AND the peak at least
    # baseline_gap_db above the rolling baseline (distinguishes a spike from a
    # sustained loud room).
    spike_threshold_db: -15
    spike_min_duration_ms: 100
    spike_baseline_gap_db: 20
    # Live audio-level meter publish cadence (Hz), retained for the dashboard.
    publish_level_hz: 2

  # Slice 5 anomaly-triggered recordings (V5.7). On any anomaly, bracket the
  # moment with a finite HLS recording: T_before from the ring + T_after of fresh
  # forward capture, under recordings/anomaly/<id>/.
  anomaly:
    before_seconds: 30
    after_seconds: 60
    # Auto-flag anomaly recordings for upload? Default false preserves the
    # Slice-4 "operator decides" property; revisit once the alert load is real.
    auto_upload: false

# --- supervisor -------------------------------------------------------------

supervisor:
  http:
    host: 0.0.0.0
    port: 8443
    # In production, terminate HTTPS here (reachable from the cluster over
    # Tailscale). For local dev, leave these unset to serve plain HTTP.
    # tls_certfile: /etc/fessel/tls/supervisor.crt
    # tls_keyfile: /etc/fessel/tls/supervisor.key

  # Slice 3 control plane: the actuators supervisor drives directly.
  # Omit a plug (no address) or the jetson block to disable the matching
  # endpoints rather than have them pretend an actuator exists.
  control:
    plugs:
      # WiZ smart plugs on the local LAN (pywizlight over UDP, port 38899).
      # IMPORTANT: the device switching the ARM supply must be load-rated for
      # the arm's current draw — a hardware prerequisite, verified at install.
      arm:
        address: 192.168.1.50
      jetson:
        address: 192.168.1.51
    wiz:
      # Send-and-verify retry policy. A lost UDP power-off is a missed safety
      # intervention, so each attempt re-issues the command and reads it back.
      retries: 3
      retry_delay_s: 0.2
    jetson:
      # Jetson control API over the local LAN (not on the tailnet). Short
      # timeout: long timeouts hide failures on a local LAN.
      base_url: http://192.168.1.40:8080
      timeout_s: 3.0
      # Optional pre-shared token sent as `Authorization: Bearer <token>`.
      # Leave unset if the LAN is trusted (agree with the Jetson team).
      # auth_token: null
    refresh:
      # Slow background refresh that keeps /state's cached view fresh without
      # re-querying on every read.
      jetson_s: 5.0
      plug_s: 10.0

  # Slice 5 sensing ingest (X5.2): the in-memory anomaly log + vision/audio
  # heartbeat staleness. The log is lost on restart (Loki via promtail is the
  # durable record, Slice 7).
  anomalies:
    # Bounded log size; `recent_cap` is how many show in /state's
    # recent_anomalies (the full set is on /anomalies).
    log_cap: 100
    recent_cap: 10
    # A vision heartbeat / audio level older than this marks the channel
    # unhealthy in /state (vision.healthy / audio.healthy = false).
    heartbeat_staleness_s: 6.0

# --- uploader ---------------------------------------------------------------

uploader:
  # Slice 5.5: the uploader PUTs each recording file to webui-backend's
  # tailnet-only recording-ingest endpoint. The Pi holds NO cluster-store
  # credentials — auth is by Tailscale identity at the network layer.
  # 'http' (prod) | 'fake' (in-memory, integration only).
  driver: http
  # webui-backend's recording-ingest Tailscale ingress (from the Tanka
  # webui-recording-ingest Service). No scheme-less host: a full https:// base.
  # The uploader PUTs to <ingest_url_base>/recording-ingest/<id>/<file>.
  ingest_url_base: "https://fessel-ingest.tailnet.ts.net:8443"
  # Per-PUT timeout (segments can be several MB on a slow uplink).
  timeout_s: 60
  # Verify the ingress TLS cert. Leave true in production.
  verify_tls: true

  upload:
    # Retryable-failure backoff schedule (seconds); the last value is the cap.
    backoff_s: [30, 60, 300, 900, 1800]
    # How often to scan the upload_queue for new markers.
    poll_interval_s: 10.0
    # How often to publish the backlog gauges (count + oldest-pending age, V4.8).
    backlog_interval_s: 30.0
