# Live-preview webui: serves the /live page and mints WHEP URLs pointing at
# the PUBLIC mediamtx host so a real browser can reach it. Exposed via HTTPS
# Ingress at ${WEBUI_HOST}.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webui
  labels: { app: webui }
spec:
  replicas: 1
  selector:
    matchLabels: { app: webui }
  template:
    metadata:
      labels: { app: webui }
    spec:
      containers:
        - name: webui
          image: ${REGISTRY}/fessel-webui:${IMAGE_TAG}
          env:
            - name: FESSEL_WHEP_SECRET
              valueFrom:
                secretKeyRef: { name: fessel-whep-secret, key: secret }
            # Minted WHEP URL base = the PUBLIC mediamtx host (browser-reachable).
            - name: FESSEL_MEDIA_BASE
              value: "https://${MEDIA_HOST}"
            # Longer TTL for interactive manual use.
            - name: FESSEL_WHEP_TTL_S
              value: "300"
          ports:
            - { containerPort: 8000 }
          readinessProbe:
            httpGet: { path: /healthz, port: 8000 }
            initialDelaySeconds: 2
            periodSeconds: 3
          resources:
            requests: { cpu: 100m, memory: 128Mi }
---
apiVersion: v1
kind: Service
metadata:
  name: webui
spec:
  selector: { app: webui }
  ports:
    - { port: 8000, targetPort: 8000 }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: webui
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: nginx
  tls:
    - hosts: ["${WEBUI_HOST}"]
      secretName: live-webui-tls
  rules:
    - host: ${WEBUI_HOST}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: webui, port: { number: 8000 } }
