# Single shared secret consumed by BOTH the webui backend (env var) and
# the mediamtx config (JWKS key material is the same secret) — so signer
# and verifier never diverge (architecture §5.4 single-Secret wiring).
apiVersion: v1
kind: Secret
metadata:
  name: fessel-whep-secret
stringData:
  secret: "${FESSEL_WHEP_SECRET}"
