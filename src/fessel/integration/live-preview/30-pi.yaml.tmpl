# The test-Pi container: dpkg-installed supervisor + video + mosquitto,
# camera = videotestsrc (no device, no privilege). The `supervisor` Service
# is what mediamtx's runOnDemand curl targets (stands in for the Tailscale
# egress); it also exposes the /state/live observability read path.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pi
  labels: { app: pi }
spec:
  replicas: 1
  selector:
    matchLabels: { app: pi }
  template:
    metadata:
      labels: { app: pi }
    spec:
      containers:
        - name: pi
          image: ${REGISTRY}/fessel-test-pi:${IMAGE_TAG}
          ports:
            - { name: control, containerPort: 8443, protocol: TCP }
          readinessProbe:
            httpGet: { path: /healthz, port: 8443 }
            initialDelaySeconds: 5
            periodSeconds: 3
            failureThreshold: 30
          resources:
            requests: { cpu: 300m, memory: 384Mi }
---
# Control plane Service. mediamtx resolves `supervisor` (in-cluster DNS)
# for runOnDemand; the test Job reads /state/live here too.
apiVersion: v1
kind: Service
metadata:
  name: supervisor
spec:
  selector: { app: pi }
  ports:
    - { name: control, port: 8443, targetPort: 8443, protocol: TCP }
