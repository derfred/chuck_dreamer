# Live-preview mediamtx: PRODUCTION WebRTC exposure so a REAL browser over
# the public internet can connect (the per-PR integration test uses pod-IP
# candidates that only work in-cluster). WebRTC media via NodePort on the
# node public IPs; WHEP signaling via HTTPS Ingress.
#
# ${VARS}: NS, IMAGE_TAG, REGISTRY, FESSEL_WHEP_SECRET, NODE_PUBLIC_IPS
# (comma-separated, e.g. "85.10.209.85","88.99.140.171"), WEBUI_HOST,
# MEDIA_HOST, WRTC_UDP_NODEPORT, WRTC_TCP_NODEPORT.
apiVersion: v1
kind: ConfigMap
metadata:
  name: mediamtx-config
data:
  mediamtx.yml: |
    logLevel: info
    logDestinations: [stdout]
    readTimeout: 10s
    writeTimeout: 10s
    rtsp: no
    rtmp: no
    hls: no
    srt: yes
    webrtc: yes
    api: yes
    metrics: yes
    srtAddress: :8890
    # Production WebRTC: advertise node public IPs; media flows over the
    # NodePort (externalTrafficPolicy: Local). No STUN needed — the public
    # IPs are directly reachable ICE host candidates.
    webrtcLocalUDPAddress: :${WRTC_UDP_NODEPORT}
    webrtcLocalTCPAddress: :${WRTC_TCP_NODEPORT}
    webrtcAdditionalHosts: [${NODE_PUBLIC_IPS}]
    webrtcICEServers2: []
    # JWT auth validated locally against the webui JWKS (no callback).
    # Publish excluded (the Pi's SRT ingest can't carry a JWT). Requires
    # mediamtx >= 1.13.0.
    authMethod: jwt
    authJWTJWKS: http://webui:8000/jwks
    authJWTClaimKey: mediamtx_permissions
    authJWTInHTTPQuery: true
    authJWTExclude:
      - action: publish
      - action: api
      - action: metrics
      - action: pprof
    pathDefaults:
      source: publisher
    paths:
      pi:
        source: publisher
        runOnDemand: >
          wget -q -O- --header="Content-Type: application/json"
          --post-data="{\"path\":\"$MTX_PATH\",\"query\":\"$MTX_QUERY\"}"
          http://supervisor:8443/control/live/activate
        runOnUnDemand: >
          wget -q -O- --header="Content-Type: application/json"
          --post-data="{\"path\":\"$MTX_PATH\"}"
          http://supervisor:8443/control/live/deactivate
        runOnDemandStartTimeout: 15s
        runOnDemandCloseAfter: 10s
        runOnDemandRestart: no
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mediamtx
  labels: { app: mediamtx }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: mediamtx }
  template:
    metadata:
      labels: { app: mediamtx }
    spec:
      # Non-root: avoids per-UID inotify exhaustion that crashes mediamtx on
      # these shared nodes (see integration README).
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      containers:
        - name: mediamtx
          image: bluenviron/mediamtx:1.18.2-ffmpeg
          args: ["/config/mediamtx.yml"]
          ports:
            - { name: whep, containerPort: 8889, protocol: TCP }
            - { name: srt, containerPort: 8890, protocol: UDP }
            - { name: wrtc-udp, containerPort: ${WRTC_UDP_NODEPORT}, protocol: UDP }
            - { name: wrtc-tcp, containerPort: ${WRTC_TCP_NODEPORT}, protocol: TCP }
            - { name: api, containerPort: 9997, protocol: TCP }
          resources:
            requests: { cpu: 200m, memory: 256Mi }
          volumeMounts:
            - { name: config, mountPath: /config }
      volumes:
        - name: config
          configMap: { name: mediamtx-config }
---
# WHEP signaling (browser entry, behind HTTPS Ingress).
apiVersion: v1
kind: Service
metadata:
  name: mediamtx
spec:
  selector: { app: mediamtx }
  ports:
    - { name: whep, port: 8889, targetPort: 8889, protocol: TCP }
    - { name: api, port: 9997, targetPort: 9997, protocol: TCP }
---
# SRT ingest from the Pi (in-cluster).
apiVersion: v1
kind: Service
metadata:
  name: mediamtx-srt
spec:
  selector: { app: mediamtx }
  ports:
    - { name: srt, port: 8890, targetPort: 8890, protocol: UDP }
---
# WebRTC media: NodePort on the node public IPs, Local traffic policy so ICE
# converges on whichever node hosts the pod.
apiVersion: v1
kind: Service
metadata:
  name: mediamtx-webrtc
spec:
  type: NodePort
  externalTrafficPolicy: Local
  selector: { app: mediamtx }
  ports:
    - { name: wrtc-udp, port: ${WRTC_UDP_NODEPORT}, targetPort: ${WRTC_UDP_NODEPORT}, nodePort: ${WRTC_UDP_NODEPORT}, protocol: UDP }
    - { name: wrtc-tcp, port: ${WRTC_TCP_NODEPORT}, targetPort: ${WRTC_TCP_NODEPORT}, nodePort: ${WRTC_TCP_NODEPORT}, protocol: TCP }
---
# HTTPS Ingress for WHEP signaling, CORS-allowing the webui origin.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mediamtx
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    nginx.ingress.kubernetes.io/enable-cors: "true"
    nginx.ingress.kubernetes.io/cors-allow-origin: https://${WEBUI_HOST}
    nginx.ingress.kubernetes.io/cors-allow-methods: "GET, POST, PATCH, DELETE, OPTIONS"
    nginx.ingress.kubernetes.io/cors-allow-headers: "Content-Type, Authorization"
spec:
  ingressClassName: nginx
  tls:
    - hosts: ["${MEDIA_HOST}"]
      secretName: live-mediamtx-tls
  rules:
    - host: ${MEDIA_HOST}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: mediamtx, port: { number: 8889 } }
