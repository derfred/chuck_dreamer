# Local dev: run mosquitto + supervisor + video together (I0.4).
# Use with `honcho start` or `foreman start` from src/fessel/.
#
# video MUST be invoked via its --system-site-packages venv binary directly
# (see pi/video venv note). supervisor uses a clean uv venv.
mosquitto: mosquitto -c pi/deploy/mosquitto.conf
supervisor: SUPERVISOR_CONFIG=pi/deploy/supervisor.yaml.example pi/supervisor/.venv/bin/supervisor
video: VIDEO_CONFIG=pi/deploy/video.yaml.example pi/video/.venv/bin/video
backend: cd webui/backend && FESSEL_WHEP_SECRET=dev-secret FESSEL_MEDIA_BASE=http://localhost:8889 uv run uvicorn app.main:app --port 8000
frontend: cd webui/frontend && npm run dev
