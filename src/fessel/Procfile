# Local dev: run mosquitto + supervisor + video + webui together (I0.4).
# Use with `honcho start` or `foreman start` from src/fessel/.
#
# video MUST be invoked via its --system-site-packages venv binary directly
# (see pi/video venv note). supervisor uses a clean uv venv. The Go webui
# serves the API on :8000 (+ ingest on :8001); the vite dev server proxies
# /api to it.
mosquitto: mosquitto -c pi/deploy/mosquitto.conf
supervisor: FESSEL_CONFIG=pi/deploy/fessel.yaml.example pi/supervisor/.venv/bin/supervisor
video: FESSEL_CONFIG=pi/deploy/fessel.yaml.example pi/video/.venv/bin/video
webui: cd webui && FESSEL_SUPERVISOR_BASE=http://localhost:8443 FESSEL_RECORDINGS_BACKEND=disk FESSEL_RECORDINGS_DISK_PATH=/tmp/fessel-recordings go run ./cmd/webui
frontend: cd webui/frontend && npm run dev
