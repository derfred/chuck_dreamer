# mediamtx config template (M1.1, M1.2). Rendered by
# tools/render-mediamtx-config.sh; ${VARS} are substituted at deploy time.
# Uses the upstream bluenviron/mediamtx image at a pinned version — no fork.

logLevel: info
logDestinations: [stdout]

readTimeout: 10s
writeTimeout: 10s

# --- protocols: SRT in, WebRTC out. RTSP/RTMP/HLS disabled. ---
rtsp: no
rtmp: no
hls: no
srt: yes
webrtc: yes
api: yes
metrics: yes

# SRT ingest from the Pi (Tailscale ingress Service -> :8890).
srtAddress: :8890

# --- WebRTC media exposure ---
# All three cluster node public IPs; ICE converges on the live one.
webrtcAdditionalHosts: [${WEBRTC_ADDITIONAL_HOSTS}]
# Single fixed UDP port matching the NodePort (I1.2).
webrtcLocalUDPAddress: :${WEBRTC_UDP_PORT}
# TCP fallback port (Firefox on non-HTTPS origins / UDP blocked).
webrtcLocalTCPAddress: :${WEBRTC_TCP_PORT}
# Public STUN; singular url: form. No TURN.
webrtcICEServers2:
  - url: ${STUN_URL}

# --- WHEP auth: HS256 JWT validated locally against the backend JWKS. ---
# No per-request callback to the backend; mediamtx fetches the JWKS once
# and validates the signature + expiry itself. The token's signature is an
# HMAC over (path, mode, expiry) expressed as JWT claims (see backend
# app/token.py). The shared secret is the JWKS `oct` key.
# Requires mediamtx >= 1.13.0 (authJWTExclude / authJWTInHTTPQuery).
authMethod: jwt
authJWTJWKS: ${BACKEND_JWKS_URL}
authJWTClaimKey: mediamtx_permissions
# mediamtx reads the JWT from the `jwt` query parameter on the WHEP URL.
authJWTInHTTPQuery: true
# Exclude the Pi's trusted SRT publish from JWT auth: a JWT cannot be
# carried over SRT (streamid is capped at 512 chars). Read (WHEP) still
# requires a valid token, so the only trigger that starts encoding is a
# valid signed token. api/metrics excluded as operational endpoints.
authJWTExclude:
  - action: publish
  - action: api
  - action: metrics

pathDefaults:
  source: publisher

paths:
  ${LIVE_PATH}:
    source: publisher
    # runOnDemand fires only after the WHEP token is validated above, so
    # the only trigger that reaches the Pi is a valid signed token. We hand
    # supervisor the raw WHEP query; it extracts `mode` (avoids fragile
    # nested-quote shell parsing). $MTX_PATH / $MTX_QUERY are mediamtx vars.
    runOnDemand: >
      curl -fsS -X POST -H "Content-Type: application/json"
      --data "{\"path\":\"$MTX_PATH\",\"query\":\"$MTX_QUERY\"}"
      ${SUPERVISOR_BASE}/control/live/activate
    runOnUnDemand: >
      curl -fsS -X POST -H "Content-Type: application/json"
      --data "{\"path\":\"$MTX_PATH\"}"
      ${SUPERVISOR_BASE}/control/live/deactivate
    runOnDemandStartTimeout: 15s
    runOnDemandCloseAfter: 10s
    runOnDemandRestart: no
